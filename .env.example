# =============================================================================
# weekly-agent-report / 環境変数サンプル
# 使い方: このファイルを .env にコピーして値を埋める
#   cp .env.example .env
# =============================================================================

# --- 必須 --------------------------------------------------------------------

# 組織 bot トークン（scope: workflows:read が必要）
# ※ 強い権限。全員に配らず、この1か所に集約すること。
NOTION_ADMIN_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 対象スペース(ワークスペース)の UUID
SPACE_ID=00000000-0000-0000-0000-000000000000

# --- 任意 --------------------------------------------------------------------

# Admin API バージョン（未設定なら 2026-06-01）
# NOTION_VERSION=2026-06-01

# 集計期間（日数、未設定なら 7 = 直近1週間）
# WINDOW_DAYS=7

# 担当ID→氏名 の変換に使う「通常の」Notion API トークン（任意）
# 未設定だと担当欄は ID 表示になる
# NOTION_API_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 出力先 Notion DB の ID（1行＝1エージェントの詳細。設定した時だけ upsert）
# ※ 書き込みには NOTION_API_TOKEN も必要
# ↓ 自分のダッシュボードに作った「カスタムエージェント 週次レポート」DB の ID に置き換える
# OUTPUT_DATABASE_ID=00000000000000000000000000000000

# 週次ログ DB の ID（1行＝1週間のサマリー。設定した時だけ1行 upsert）
# 「週」ラベルをキーに、同じ週なら更新・無ければ追加（所感・効果は手入力を保持）
# WEEKLY_LOG_DATABASE_ID=00000000000000000000000000000000

# 月次累積ログ DB の ID（1行＝1ヶ月・1月起点の累積クレジット。当月行を upsert）
# MONTHLY_LOG_DATABASE_ID=00000000000000000000000000000000

# 部署マスタ（People DB）… 作成者ID→部署 の対応表として使う（任意）
# DEPT_DB_TOKEN: その DB を読めるトークン（別ワークスペースならその WS のトークン）
# DEPT_DB_ID: People DB の ID
# DEPT_DB_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEPT_DB_ID=00000000000000000000000000000000

# クレジット上限の書き戻し（高影響・既定OFF）
# true にすると「希望クレジット上限」列を Admin API で実際のエージェントに反映する
# ★ Admin token に workflows:write が必要
# ENABLE_CREDIT_LIMIT_WRITEBACK=true

# 稼働状態の書き戻し（高影響・既定OFF）
# true にすると「稼働状態」を 稼働中↔停止中 に変えた時、Admin API で実際に停止/再開する
# ★ Admin token に workflows:write が必要
# ENABLE_STATUS_WRITEBACK=true

# 日次クレジットログ DB の ID（1行＝1エージェント×1日。各エージェントの日次消費推移用）
# DAILY_LOG_DATABASE_ID=00000000000000000000000000000000
